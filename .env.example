# Container image published from the gosaad application repository.
GOSAAD_IMAGE=ghcr.io/gosaad/gosaad
GOSAAD_IMAGE_TAG=latest

# Public hostname and ACME contact for Caddy-managed HTTPS.
CADDY_DOMAIN=gosaad.example.com
CADDY_EMAIL=admin@example.com

# Required database and application secrets. Generate every password/secret
# uniquely for each deployment.
POSTGRES_PASSWORD=
APP_DB_NAME=gosaad
APP_DB_USER=gosaad_app
APP_DB_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional database-restore administrative account. Leave both blank unless
# the application restore feature is enabled.
SYSTEM_RESTORE_MAINTENANCE_DB=postgres
SYSTEM_RESTORE_DB_ADMIN_USER=
SYSTEM_RESTORE_DB_ADMIN_PASSWORD=
SYSTEM_RESTORE_DB_ADMIN_SSLMODE=disable
SYSTEM_RESTORE_ENABLED=false
SYSTEM_RESTORE_STATE_DIR=/app/runtime/storage/restores
SYSTEM_RESTORE_PG_RESTORE_PATH=/usr/bin/pg_restore
SYSTEM_RESTORE_RESTART_STRATEGY=supervisor
SYSTEM_RESTORE_INSTANCE_COUNT=1
SYSTEM_RESTORE_SUPERVISOR_VERIFIED=false

