# Required image version, database, and application secrets. Generate every
# password/secret uniquely for each deployment.
APP_VERSION=0.1.0-pre.4
POSTGRES_PASSWORD=
APP_DB_NAME=gosaad
APP_DB_USER=gosaad_app
APP_DB_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# The dedicated restore role is provisioned at startup even while the restore
# feature is disabled.
SYSTEM_RESTORE_MAINTENANCE_DB=postgres
SYSTEM_RESTORE_TEMPLATE_DB=gosaad_restore_template
SYSTEM_RESTORE_DB_ADMIN_USER=gosaad_restore
SYSTEM_RESTORE_DB_ADMIN_PASSWORD=
SYSTEM_RESTORE_DB_ADMIN_SSLMODE=disable
SYSTEM_RESTORE_ENABLED=false
SYSTEM_RESTORE_STATE_DIR=/app/runtime/storage/restores
SYSTEM_RESTORE_PG_RESTORE_PATH=/usr/bin/pg_restore
SYSTEM_RESTORE_RESTART_STRATEGY=supervisor
SYSTEM_RESTORE_INSTANCE_COUNT=1
SYSTEM_RESTORE_SUPERVISOR_VERIFIED=false
